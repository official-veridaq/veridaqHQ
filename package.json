{
  "name": "veridaq",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "private": true,
  "description": "Privacy-preserving academic credential verification using ZKPs on Soroban (Stellar).",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "pnpm --filter veridaq-backend dev",
    "dev:frontend": "pnpm --filter veridaq-frontend dev",
    "build:backend": "pnpm --filter veridaq-backend build",
    "build:frontend": "pnpm --filter veridaq-frontend build",
    "test:backend": "pnpm --filter veridaq-backend test",
    "test:contracts": "cd contracts && cargo test",
    "lint": "eslint backend/src frontend/app frontend/components frontend/lib --ext .ts,.tsx",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "db:generate": "pnpm --filter veridaq-backend db:generate",
    "db:migrate": "pnpm --filter veridaq-backend db:migrate",
    "db:push": "pnpm --filter veridaq-backend db:push",
    "db:seed": "pnpm --filter veridaq-backend db:seed",
    "db:studio": "pnpm --filter veridaq-backend db:studio",
    "db:reset": "pnpm --filter veridaq-backend db:reset",
    "circuit:compile": "pnpm --filter veridaq-circuits compile",
    "circuit:setup": "pnpm --filter veridaq-circuits setup",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@stellar/stellar-sdk": "^15.1.0"
  }
}
