# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_this_with_a_very_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_SECRET=replace_this_with_another_very_long_random_string
REFRESH_EXPIRES_IN=7d
EXTENSION_JWT_EXPIRES_IN=5m

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://veridaq:veridaq_dev@localhost:5432/veridaq

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stellar RPC ──────────────────────────────────────────────
# Get from: https://dashboard.alchemy.com (Soroban RPC) or https://soroban.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contracts ────────────────────────────────────────────────
# Deployed contract IDs (filled after running deploy script)
INSTITUTION_REGISTRY_ID=
CREDENTIAL_REGISTRY_ID=
REVOCATION_REGISTRY_ID=
ZK_VERIFIER_ID=
XLM_ASSET_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ── Signing ──────────────────────────────────────────────────
# The platform admin's Stellar secret key — for deploying contracts and
# performing admin on-chain actions. NEVER commit this.
# Generate with: stellar keys generate veridaq-admin
PLATFORM_ADMIN_SECRET_KEY=
PLATFORM_ADMIN_PUBLIC_KEY=

# ── Circuits ─────────────────────────────────────────────────
# Path to the compiled proving key (relative to workspace root, or absolute).
# After running `pnpm circuit:setup` these files will be at:
CIRCUIT_ZKEY_PATH=circuits/build/credential_final.zkey
CIRCUIT_WASM_PATH=circuits/build/credential_js/credential.wasm
# Docker / production override (uncomment when running inside the container):
# CIRCUIT_ZKEY_PATH=/app/circuits/build/credential_final.zkey
# CIRCUIT_WASM_PATH=/app/circuits/build/credential_js/credential.wasm

# ── Encryption ───────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of credential plaintext
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars_openssl_rand_hex_32

# ── Email ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@veridaq.xyz
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=VERIDAQ <notifications@veridaq.xyz>

# Extension allowed origins, comma separated
EXTENSION_ORIGINS=

# ── Crossmint ────────────────────────────────────────────────
# Crossmint handles fiat-to-crypto on-ramp for all platform payments.
# Get keys from: https://dashboard.crossmint.com
CROSSMINT_SERVER_API_KEY=your_crossmint_server_api_key
CROSSMINT_WEBHOOK_SECRET=your_crossmint_webhook_secret

# ── Frontend (Next.js public env) ────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
